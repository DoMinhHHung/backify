# Copy to .env in this same directory (services/control-plane/.env) — godotenv
# loads it automatically on `go run ./cmd/api` / `make run`. Never commit the
# real .env (already in .gitignore).

PORT=8080
GRPC_ADDR=:9091

# Local docker-compose default shown below. For a managed Postgres (Supabase,
# etc.), append default_query_exec_mode=simple_protocol if connecting through
# a PgBouncer transaction-mode pooler (e.g. Supabase's :6543) — pgx's default
# prepared-statement caching breaks under transaction pooling since each query
# can land on a different backend connection.
DATABASE_URL=postgres://backify:backify@localhost:5432/backify?sslmode=disable

# amqp:// or amqps:// (TLS, e.g. CloudAMQP) both work — amqp091-go detects the
# scheme automatically.
RABBITMQ_URL=amqp://backify:backify@localhost:5672/
