APP_NAME=control-plane
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# Required when APP_HOST is not loopback (127.0.0.1/localhost) and secrets
# are still placeholders. Never set true in production/staging.
ALLOW_INSECURE_DEFAULTS=true

DATABASE_URL=postgresql://backify:backify@localhost:5432/backify_control
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=20
DATABASE_STATEMENT_CACHE_SIZE=256
DATABASE_COMMAND_TIMEOUT=10

LOG_LEVEL=INFO
LOG_JSON=false

RABBITMQ_URL=amqp://backify:backify@localhost:5672/
RABBITMQ_ENABLED=true
OUTBOX_POLL_INTERVAL=1.0
OUTBOX_BATCH_SIZE=50

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_SECRET=

INTERNAL_API_KEY=

GRPC_ENABLED=true
GRPC_PORT=9091
# Optional TLS for gRPC (required when APP_ENV=production)
# GRPC_TLS_CERT_FILE=/path/to/server.crt
# GRPC_TLS_KEY_FILE=/path/to/server.key
# Optional mutual TLS (client cert verification)
# GRPC_TLS_CLIENT_CA_FILE=/path/to/ca.crt

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
