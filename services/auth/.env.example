# Copy to .env in this same directory (services/auth/.env) — godotenv loads
# it automatically on `go run ./cmd/api` / `make run-auth`. Never commit the
# real .env (already in .gitignore).

PORT=8081
CONTROL_PLANE_GRPC_ADDR=localhost:9091

# AUTH_DATABASE_URL must point to a Postgres instance where the connecting
# user can CREATE DATABASE / DROP DATABASE — this is the admin connection
# DatabaseManager uses to provision auth_proj_<project_id> per project.
# Managed single-database Postgres (Supabase, most serverless Postgres) does
# NOT support this — keep this one on a real Postgres instance (local docker,
# a VPS, or a provider that explicitly allows multi-database) even if
# everything else here is external.
AUTH_DATABASE_URL=postgres://backify:backify@localhost:5433/auth?sslmode=disable

# redis:// or rediss:// (TLS, e.g. Upstash) both work — go-redis detects the
# scheme automatically.
REDIS_URL=redis://localhost:6379/0

# amqp:// or amqps:// (TLS, e.g. CloudAMQP) both work.
RABBITMQ_URL=amqp://backify:backify@localhost:5672/

# Bước 5 — not read yet, placeholder for when JWT issuing lands.
JWT_SECRET=change-me-in-production-use-long-random-string
